# ─── JARVIS Personal AI Operating System Environment ──────────────────────
# Copy this file to .env and configure your parameters.
# NEVER commit .env to version control.
# Flag any real production credentials for rotation if ever committed.

# Application Environment & HTTP Server
JARVIS_ENV=development
JARVIS_HOST=0.0.0.0
JARVIS_PORT=8000
JARVIS_DEBUG=true
JARVIS_SECRET_KEY=jarvis_secret_hmac_production_key_32bytes
JARVIS_USER_NAME=Ganesh Nair
JARVIS_USER_ID=ganesh
CORS_ALLOW_ORIGINS=["*"]
DISK_MOUNT_PATH=C:\

# Local Model & Ollama
OLLAMA_BASE_URL=http://localhost:11434
LOCAL_MODEL=ollama/llama3.1
OLLAMA_DEFAULT_MODEL=llama3.1
OLLAMA_EMBED_MODEL=nomic-embed-text

# LiteLLM Unified Model Gateway
LITELLM_BASE_URL=http://localhost:4000
LITELLM_MASTER_KEY=changeme

# Mem0 Long-Term Memory
MEM0_API_KEY=your_mem0_key
MEM0_USER_ID=ganesh

# Cloud Model Providers & OpenRouter Free Tier (Optional - falls back to local models)
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GEMINI_API_KEY=
CLAUDE_API_KEY=
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_DEFAULT_MODEL=openrouter/free

# Persistence & Queues (PostgreSQL + Redis)
DATABASE_URL=postgresql+psycopg://jarvis:jarvis@localhost:5432/jarvis
REDIS_URL=redis://localhost:6379/0
REDIS_SOCKET_TIMEOUT_SEC=1.0

# Search Engines & Vector Stores
SEARCH_DB_PATH=data/search.db
SEARCH_CACHE_TTL_SEC=3600
MEILISEARCH_URL=http://localhost:7700
MEILISEARCH_MASTER_KEY=jarvis_meili_master_key
QDRANT_URL=http://localhost:6333
QDRANT_COLLECTION=jarvis_documents
SEARXNG_URL=http://localhost:8080

# Hybrid RRF Search Ranking Parameters
RRF_K=60
RRF_KEYWORD_WEIGHT=0.40
RRF_SEMANTIC_WEIGHT=0.35
RRF_INSTANT_WEIGHT=0.25

# Ingestion & Chunking
INGEST_CHUNK_SIZE=1200
INGEST_CHUNK_OVERLAP=200

# Browser Automation & Web Scraping
BROWSER_HEADLESS=true
BROWSER_TIMEOUT_MS=15000
BROWSER_SEARCH_TIMEOUT_SEC=10.0

# Desktop Worker & Computer Control
DESKTOP_ACTION_PAUSE_SEC=0.1
DESKTOP_ALLOWED_APPS=["notepad","code","cmd","powershell","explorer","calculator","terminal"]

# Voice Subsystems (Wake-word, PTT, TTS)
VOICE_WAKE_PHRASES=["hey jarvis","jarvis","ok jarvis"]
VOICE_SENSITIVITY=0.5
VOICE_ENERGY_THRESHOLD=85.0
TTS_SPEED=1
TTS_VOLUME=100

# Cost Governor Limits (USD)
DAILY_BUDGET_LIMIT=5.00
MONTHLY_BUDGET_LIMIT=50.00
MAX_PER_TASK_BUDGET=0.50

# Security & Policies
POLICY_STRICT_MODE=true
ALLOW_UNAPPROVED_READS=true
KILL_SWITCH_HOTKEY=ctrl+alt+shift+k

# Local Storage Paths
DB_PATH=data/jarvis.db
AUDIT_LOG_PATH=data/logs/audit.jsonl
SCREENSHOT_DIR=data/screenshots
