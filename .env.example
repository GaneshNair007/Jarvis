# ─── JARVIS Environment Configuration ───────────────────────────────────────
# Copy this file to .env and configure your personal parameters.
# NEVER commit .env to version control.

# Application Core
JARVIS_ENV=development
JARVIS_HOST=127.0.0.1
JARVIS_PORT=8000
JARVIS_DEBUG=true
JARVIS_SECRET_KEY=generate_a_random_32_byte_hex_key_here

# User Identification
JARVIS_USER_NAME=Ganesh Nair
JARVIS_USER_ID=ganesh

# Tier 1: Local Reflex (Ollama)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_DEFAULT_MODEL=llama3.2:3b
OLLAMA_EMBED_MODEL=nomic-embed-text

# Tier 2: Private GPU Reasoning (vLLM OpenAI-Compatible Server)
VLLM_BASE_URL=http://localhost:8001/v1
VLLM_API_KEY=vllm-local-secret
VLLM_DEFAULT_MODEL=Qwen/Qwen2.5-32B-Instruct

# Tier 3: Frontier Cloud Gateway
CLAUDE_API_KEY=
OPENAI_API_KEY=
GEMINI_API_KEY=
CLOUD_GATEWAY_TIMEOUT_SEC=45

# Cost Governor Limits (USD)
DAILY_BUDGET_LIMIT=5.00
MONTHLY_BUDGET_LIMIT=50.00
MAX_PER_TASK_BUDGET=0.50

# Security & Policies
POLICY_STRICT_MODE=true
ALLOW_UNAPPROVED_READS=true
KILL_SWITCH_HOTKEY=ctrl+alt+shift+k

# Paths & Storage
DB_PATH=data/jarvis.db
AUDIT_LOG_PATH=data/logs/audit.jsonl
SCREENSHOT_DIR=data/screenshots
